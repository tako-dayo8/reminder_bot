FROM golang:1.26.5 AS builder

WORKDIR /usr/src/app

COPY go.mod go.sum ./
RUN go mod download


COPY ./cmd ./cmd
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o reminder_bot ./cmd

FROM gcr.io/distroless/static-debian12:debug-nonroot

WORKDIR /app
COPY --from=builder --chown=nonroot:nonroot --chmod=755 /usr/src/app/reminder_bot .

ENTRYPOINT [ "sh" ]